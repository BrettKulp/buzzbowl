{
    "hosting": {
      "public": "dist", 
      "headers": [
        {
          "source": "**/*.mp4", 
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000"
            }
          ]
        },
        {
          "source": "**/*.webp",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000" 
            }
          ]
        }
      ],
      "rewrites": [ 
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  }
  